<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- LAN control uses cleartext WebSocket (ws://) on private IPs. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
